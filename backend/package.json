{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate up -m migrations",
    "migrate:dev": "dotenv run -f .env -- node-pg-migrate up -m migrations",
    "migrate:create": "node-pg-migrate create -m migrations -j sql",
    "seed": "tsx src/db/seed.ts",
    "test": "npm run test:unit",
    "test:integration": "dotenv run -f .env.test -- tsx --test --test-concurrency=1 \"test/*.integration.test.ts\"",
    "test:unit": "dotenv run -f .env.test -- tsx --test \"test/unit/**/*.test.ts\"",
    "test:all": "npm run test:unit && npm run test:integration",
    "seed:prod": "node dist/db/seed.js",
    "start:deploy": "npm run migrate && npm run seed:prod && npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
